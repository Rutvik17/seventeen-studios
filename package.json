{
  "name": "seventeen-studios",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck",
    "postbuild": "node scripts/verify-og.mjs && node scripts/verify-assets.mjs",
